<ui:FluentWindow x:Class="OsuInstafade.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="osu! Instafade by LTH"
                 Width="600" Height="880" MinWidth="520" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/app.ico"
                 AllowDrop="True"
                 DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="osu! Instafade  by LTH">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
            <StackPanel>

                <!-- 소개 -->
                <TextBlock Text="서클 잔상 제거기" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,16" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="osu! 스킨을 넣고 버튼만 누르면, 서클을 친 뒤 퍼지며 남는 잔상이 없는 새 스킨(.osk)을 만들어 줍니다. 원본은 그대로 둡니다." />

                <!-- 1. 스킨 넣기 -->
                <Grid x:Name="DropZone" MinHeight="170">
                    <Rectangle x:Name="DropBorder" RadiusX="14" RadiusY="14" StrokeThickness="2"
                               StrokeDashArray="5 4"
                               Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}"
                               Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <StackPanel VerticalAlignment="Center" Margin="16">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,8,0,2" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Text=".osk 파일이나 스킨 폴더를 여기로 끌어다 놓으세요" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="여러 개를 한꺼번에 넣어도 됩니다" />
                        <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Center">
                            <ui:Button Content=".osk 파일 선택" Margin="4" Click="OnPickFiles">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="스킨 폴더 선택" Margin="4" Click="OnPickFolders">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:Button.Icon>
                            </ui:Button>
                            <ComboBox x:Name="InstalledSkins" Margin="4" MinWidth="170" MaxWidth="240"
                                      DisplayMemberPath="Name" SelectionChanged="OnInstalledSkinChosen"
                                      ToolTip="이 PC에 설치된 osu! 스킨 목록" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- 2. 선택한 스킨 -->
                <ui:Card x:Name="SkinCard" Margin="0,14,0,0" Visibility="Collapsed" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SkinName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SkinInfo" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SkinPath" Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Transparent" VerticalAlignment="Top" Click="OnClearInputs"
                                       ToolTip="선택 취소" Padding="6">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss20" /></ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <!-- 미리보기 -->
                        <Grid x:Name="PreviewGrid" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border CornerRadius="10" Background="#FF101014" Height="170" Margin="0,0,6,0" ClipToBounds="True">
                                    <Grid x:Name="BeforeCanvas" />
                                </Border>
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="변경 전 — 퍼지며 사라짐" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Border CornerRadius="10" Background="#FF101014" Height="170" Margin="6,0,0,0" ClipToBounds="True">
                                    <Grid x:Name="AfterCanvas" />
                                </Border>
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="변경 후 — 바로 사라짐" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="QueueList" Margin="0,10,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:InfoBar x:Name="NoticeBar" Margin="0,10,0,0" IsClosable="False" Severity="Warning" Title="알림" />

                <!-- 3. 핵심 버튼 -->
                <ui:Button x:Name="RunButton" Margin="0,16,0,0" Height="58" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Appearance="Primary" FontSize="18" FontWeight="SemiBold" IsEnabled="False"
                           Click="OnRun">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:Button.Icon>
                    <TextBlock x:Name="RunButtonText" Text="잔상 제거하기" />
                </ui:Button>
                <StackPanel x:Name="BusyPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Progress="50" />
                    <TextBlock x:Name="BusyText" Margin="10,0,0,0" VerticalAlignment="Center" Text="처리 중…" />
                </StackPanel>

                <!-- 4. 결과 -->
                <ItemsControl x:Name="ResultList" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="{Binding IconBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding ButtonsVisibility}">
                                            <ui:Button Content="osu!로 바로 가져오기" Appearance="Primary" Margin="0,0,8,0" Click="OnImportToOsu" Tag="{Binding Path}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Content="폴더 열기" Click="OnOpenFolder" Tag="{Binding Path}">
                                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                            </ui:Button>
                                        </WrapPanel>
                                        <!-- 원본 스킨 처리 -->
                                        <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Visibility="{Binding OriginalSectionVisibility}">
                                            <StackPanel>
                                                <StackPanel Visibility="{Binding OriginalChoiceVisibility}">
                                                    <TextBlock FontSize="12" Text="원본 스킨은 어떻게 할까요?" />
                                                    <TextBlock FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="{Binding SourcePath}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <ui:Button Content="원본 지우기 (휴지통으로)" Appearance="Danger" Margin="0,0,8,0" Click="OnDeleteOriginal" Tag="{Binding}">
                                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Content="원본 그대로 두기" Click="OnKeepOriginal" Tag="{Binding}">
                                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark24" /></ui:Button.Icon>
                                                        </ui:Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding OriginalStatus}"
                                                           Visibility="{Binding OriginalStatusVisibility}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 5. 고급 설정 -->
                <ui:CardExpander Margin="0,8,0,0" Header="고급 설정 (기본값 그대로 두면 됩니다)" IsExpanded="False">
                    <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:CardExpander.Icon>
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="NumbersToggle" IsChecked="True" Content="서클 위 숫자 표시"
                                         Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                        <TextBlock Margin="0,2,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="끄면 숫자 없는 서클이 됩니다. 콤보 10 이상에서 숫자가 겹쳐 보이는 문제가 없어집니다." />

                        <TextBlock Text="서클 색" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,6" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="색을 그림에 미리 입히기 때문에 한 가지 색만 쓸 수 있습니다. 기본은 스킨의 첫 번째 콤보 색입니다." />
                        <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:TextBox x:Name="CustomColorBox" Width="150" PlaceholderText="#FF66AA 또는 255,102,170" />
                            <ui:Button Content="이 색으로" Margin="8,0,0,0" Click="OnApplyCustomColor" />
                            <ui:Button Content="스킨 기본색" Margin="8,0,0,0" Click="OnResetColor" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="ComboFixToggle" IsChecked="True" Content="콤보 카운터 숫자 자동 복구" />
                        <TextBlock Margin="0,2,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="왼쪽 아래 콤보 숫자가 안 보이는 스킨이면 점수 숫자 그림을 쓰도록 고칩니다." />

                        <ui:ToggleSwitch x:Name="LightingToggle" IsChecked="False" Content="히트 라이팅 끄기" />
                        <TextBlock Margin="0,2,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="켜면 칠 때 번쩍이는 빛(lighting)도 없앱니다." />

                        <TextBlock Text="결과 저장 위치" FontWeight="SemiBold" />
                        <TextBlock x:Name="OutputDirText" Margin="0,2,0,6" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="원본과 같은 폴더" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="바꾸기" Click="OnPickOutputDir" />
                            <ui:Button Content="원본과 같은 폴더" Margin="8,0,0,0" Click="OnResetOutputDir" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 6. 알아두기 -->
                <ui:CardExpander Margin="0,8,0,0" Header="알아두기" IsExpanded="False">
                    <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Info24" /></ui:CardExpander.Icon>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        • 원리: osu!는 서클을 치면 서클 그림은 퍼지며 천천히 사라지지만 숫자 그림은 바로 사라집니다. 그래서 서클을 숫자 그림 안에 합쳐 넣고 원래 서클은 투명하게 만듭니다.<LineBreak />
                        • 콤보 10 이상: 숫자 두 개가 같은 자리에 겹쳐 보이고, 반투명 서클은 조금 진해집니다. 신경 쓰이면 "서클 위 숫자 표시"를 끄세요.<LineBreak />
                        • 콤보 색은 한 가지만 쓸 수 있습니다.<LineBreak />
                        • 따로 디자인된 슬라이더 시작 원은 일반 서클 모양으로 바뀝니다.<LineBreak />
                        • 맵에 콤보 색이 지정돼 있으면 줄어드는 원 색만 달라질 수 있습니다 (osu! 설정에서 "맵 스킨 무시"를 켜면 해결).<LineBreak />
                        • osu!lazer는 설정의 "Hit animations"를 끄면 되므로, 이 프로그램은 osu!(stable)용입니다.
                    </TextBlock>
                </ui:CardExpander>

                <TextBlock x:Name="VersionText" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="v1.0.0 · by LTH" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
